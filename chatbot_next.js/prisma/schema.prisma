generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model DocumentChunk {
  id        String                 @id @default(uuid())
  question  String
  answer    String
  embedding Unsupported("vector")?
  createdAt DateTime               @default(now())

  @@map("document_chunks")
}
